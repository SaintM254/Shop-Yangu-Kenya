# ============================================================================
#  Shop Yangu Kenya — API settings
#
#  Copy this file to api/.env and fill in the values. Every line is explained
#  in docs/01-neon-setup.md. Nothing here is committed to git.
# ============================================================================

# ------------------------------------------------------------------ server
NODE_ENV=development
PORT=8787
# 0.0.0.0 so the preview proxy (and a phone on the same wifi) can reach it.
HOST=0.0.0.0

# ---------------------------------------------------------------- database
#
# From the Neon console: Connection Details → the POOLED string.
# It looks like:
#   postgresql://neondb_owner:xxxx@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=
# postgres, or pglite for a laptop/tests with no Neon account.
DATABASE_DRIVER=postgres
DB_POOL_MAX=5

# -------------------------------------------------------------------- site
#
# Where the app is published. Used for the links inside emails.
SITE_URL=http://localhost:8787
# Where this API is reachable from the public internet. Emails and M-Pesa
# callbacks are built from this.
API_URL=http://localhost:8787
# Only if the site and the API are on different domains AND you need
# cross-site cookies. Leave blank when the API serves the site.
# COOKIE_DOMAIN=
# CORS_ORIGINS=https://saintm254.github.io

# Serve the built site from this server (development convenience).
SERVE_SITE=true
WEB_ROOT=dist

# ---------------------------------------------------------------- neon auth
#
# Managed Better Auth. Optional: without it this server sends its own codes and
# checks its own scrypt password hashes, which works.
#
# NEON_AUTH_BASE_URL is GENERATED by `neon deploy` (neon.ts declares auth: true);
# there is no field for it in the Neon console. It ends in /neondb/auth.
# NEON_AUTH_BASE_URL=
#
# 32+ characters, used by Neon's SDK to sign its own cookie. If unset, one is
# derived from TOKEN_PEPPER, so there is nothing to configure unless you would
# rather keep the two secrets separate: openssl rand -base64 32
# NEON_AUTH_COOKIE_SECRET=

# ------------------------------------------------------------------ session
SESSION_COOKIE=syk_session
SESSION_DAYS=30

# --------------------------------------------------------------------- email
#
# A code is the biggest thing in the email, so the subject line carries it:
# that saves opening the message on a slow phone.
OTP_MINUTES=10
OTP_ATTEMPTS=5
LINK_MINUTES=30
SIGNUP_MINUTES=60
# How many codes one address may ask for, in how many minutes. Five in a
# quarter of an hour is right for a shop; a test harness raises it.
OTP_WINDOW_MINUTES=15
OTP_MAX_PER_WINDOW=5

# console → codes print to the server log (development)
# smtp    → codes are emailed
EMAIL_DRIVER=console
MAIL_FROM=Shop Yangu Kenya <no-reply@shopyangu.co.ke>

# Any SMTP provider works: Resend, Postmark, SendGrid, Gmail, Zoho, cPanel.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=

# -------------------------------------------------------------------- M-Pesa
#
# The tills themselves — shortcode, passkey, consumer key and secret — are
# per shop, entered in Settings, and stored in mpesa_tills. Only the base URL
# and the callback host live here.
MPESA_ENV=sandbox
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
#
# MUST be public HTTPS and MUST NOT contain "mpesa", "m-pesa" or "safaricom":
# the Daraja portal rejects such URLs. The path is /pay/<per-shop secret>.
MPESA_CALLBACK_BASE=https://your-api-host.example.com
MPESA_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ secrets
#
# Signs the session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everybody out — which is the right thing to do if it leaks.
TOKEN_PEPPER=
