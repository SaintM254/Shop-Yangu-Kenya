# build output — produced by `node build.js`, never committed
dist/

# tooling
node_modules/
.DS_Store
*.log

# API settings — copy api/.env.example to api/.env. Never commit the real one.
api/.env

# local database files (pglite)
.pgdata/

# Neon CLI: links this directory to a Neon project. Machine-specific.
.neon

# Neon CLI's `env pull` writes here. Contains connection strings.
.env.local
