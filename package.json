{
  "name": "shop-yangu-kenya-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Shop Yangu Kenya shop app: build.js generates the site, api/ is the backend, and Vercel publishes both.",
  "scripts": {
    "build": "node build.js",
    "preview": "node build.js && npx --yes serve dist",
    "test:api": "npm --workspace api run test",
    "test:vercel": "npm --workspace api run test:vercel",
    "test:sql": "node scripts/build-sql.js && node scripts/sql-check.mjs",
    "start": "npm --workspace api start"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "api"
  ]
}
